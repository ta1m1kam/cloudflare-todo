{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-todo",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-todo",
      "database_id": "daafec5b-831a-4d29-be87-7910617c9e83"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "cloudflare-todo-images"
    }
  ]
}
